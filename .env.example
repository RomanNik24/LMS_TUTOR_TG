# Application
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lms
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH_SECRET=
OWNER_TELEGRAM_ID=123456789
TEACHER_CONTACT_URL=https://t.me/your_username
BOT_USERNAME=your_bot_username

# Sessions
SESSION_SECRET=generate_with_secrets_token_urlsafe_32
# Срок жизни сессии в днях: для учеников и для персонала разный
SESSION_TTL_DAYS_STUDENT=30
SESSION_TTL_DAYS_STAFF=7

# S3 Storage (Timeweb/Selectel/MinIO)
S3_ENDPOINT_URL=https://s3.timeweb.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lms-files
S3_REGION=ru-1
S3_PUBLIC_URL=https://your-bucket.s3.timeweb.cloud

# Sentry
SENTRY_DSN=

# Scheduler
SCHEDULE_HORIZON_WEEKS=4
DEFAULT_TIMEZONE=Europe/Moscow

# Telegram API access from RU
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_PROXY_URL=