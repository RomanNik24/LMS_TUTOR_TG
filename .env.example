# === Telegram Bot ===
# В production (ENVIRONMENT=production) приложение не стартует с заглушками
# BOT_TOKEN / JWT_SECRET_KEY — задайте реальные значения.
ENVIRONMENT=development
BOT_TOKEN=your-bot-token-here

# === Database (PostgreSQL) ===
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=my_lms

# === Redis (FSM бота, очереди задач) ===
REDIS_URL=redis://127.0.0.1:6379/0

# === JWT ===
# ОБЯЗАТЕЛЬНО в production: ключ >= 32 символов, не совпадающий с этой
# заглушкой. Сгенерируйте надёжный ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Публичный URL API (используется для кнопки Mini App) ===
API_BASE_URL=http://127.0.0.1:8000

# === Внутренний адрес Flet-приложения для прокси /app (docker-compose задаёт сам) ===
WEBAPP_UPSTREAM_URL=http://127.0.0.1:8550

# === Публичный HTTPS-домен Mini App (кнопка web_app в боте; для прода) ===
# Например: https://lms.example.com  (Telegram требует HTTPS)
WEBAPP_PUBLIC_URL=

# === Загрузка файлов ДЗ (src/api/me.py) ===
# Имя переменной строго соответствует полю Settings.max_upload_mb:
# pydantic-settings сопоставляет env-переменные регистронезависимо, поэтому
# MAX_UPLOAD_MB читается кодом. Старое имя MAX_UPLOAD_SIZE_MB игнорировалось.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20
